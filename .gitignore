# Dépendances et builds
node_modules/
frontend/dist/

# Secrets et configuration locale
.env
.env.*
!.env.example
*.pem
*.key

# Terraform
infra/aws/.terraform/
infra/aws/*.tfstate
infra/aws/*.tfstate.*
infra/aws/terraform.tfvars
infra/aws/terraform.tfvars.bak*
infra/aws/.terraform.lock.hcl.bak
infra/aws/tfplan

# Sauvegardes de base de données (contiennent des données personnelles)
backups/
*.dump
*.dump.sha256
# Même chiffrées, les sauvegardes restent hors du dépôt public ; seules les sommes
# de référence db/backup/*.sha256* sont versionnées (database-backup-restore.md §6)
*.dump.gpg

# Journaux
*.log

# Fichiers générés dans le runner par le pipeline CI/CD (backend S3, variables)
infra/aws/ci_backend_override.tf
infra/aws/ci.auto.tfvars.json
