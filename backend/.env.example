# =====================================================
# LANDOLSI TIRES — configuration du backend
# =====================================================
# Développement : copier vers backend/.env
# Production    : copier vers /etc/landolsi/backend.env (chmod 640, root:landolsi)
# Ne jamais versionner le fichier réel.

# --- Exécution ---
# development | production
NODE_ENV=development
PORT=5001
# Production derrière Nginx : 127.0.0.1 (API non exposée directement)
HOST=
# true derrière un reverse proxy (défaut : true en production)
TRUST_PROXY=

# --- Sécurité / session ---
# Obligatoire en production, au moins 32 caractères aléatoires :
#   openssl rand -hex 32
JWT_SECRET=
# true dès que le site est servi en HTTPS (défaut : true en production)
COOKIE_SECURE=
# Origines autorisées (séparées par des virgules). Inutile en production
# si le frontend et l'API sont servis par le même Nginx (/api).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Double authentification (Google/Microsoft Authenticator) ---
# Nom affiché dans l'application Authenticator
MFA_ISSUER=LANDOLSI TIRES
# Clé de chiffrement des secrets TOTP en base (openssl rand -hex 32).
# Vide : dérivée de JWT_SECRET. Ne plus la modifier une fois des comptes
# enrôlés (sinon la MFA de ces comptes doit être réinitialisée).
MFA_ENCRYPTION_KEY=

# --- PostgreSQL ---
DB_NAME=landolsi_tires
DB_USER=landolsi
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Base managée (Supabase, RDS) : true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# alter (défaut dev, ancien comportement) | safe | none (défaut production)
# En production, le schéma est géré par : npm run db:migrate
DB_SYNC=

# --- Fichiers téléversés (images pneus/marques) ---
# Défaut : backend/public/uploadPneu. Production : /var/lib/landolsi/uploads
UPLOAD_DIR=

# --- Recherche par immatriculation ---
VEHICULE_API_USERNAME=

# --- E-mail SMTP Gmail (mot de passe oublié, facture envoyée à la confirmation) ---
# EMAIL_PASS : mot de passe d'application Google (validation en deux étapes requise).
# Production : scripts/configure-email.sh (lecture sur l'entrée standard).
EMAIL_USER=
EMAIL_PASS=
# Lieu de retrait indiqué dans l'e-mail de confirmation (facultatif)
STORE_CITY=Msaken
STORE_MAPS_URL=https://maps.app.goo.gl/zJo9s75YR1j2UPc86
STORE_CONTACT_EMAIL=contact@landolsi.com

# --- Création du compte administrateur (npm run create-admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Assistants IA Mistral (conseiller pneus, SAV, analyse commerciale) ---
# Clé serveur uniquement (https://console.mistral.ai). Vide : assistants
# désactivés (HTTP 503), le reste du site fonctionne normalement.
MISTRAL_API_KEY=replace_with_your_mistral_api_key
# Modèle avec appel d'outils, disponible pour VOTRE abonnement
# (vérifier : GET https://api.mistral.ai/v1/models). Ex. ministral-14b-latest
MISTRAL_MODEL=replace_with_an_available_model
# Délai d'expiration d'un appel (ms), tours d'outils max, requêtes/min/IP
MISTRAL_TIMEOUT_MS=30000
AI_MAX_TOOL_ROUNDS=5
AI_RATE_LIMIT_PER_MINUTE=15

# --- Ancien chatbot Gemini (route /chatbot, conservée, facultatif) ---
GEMINI_API_KEY=

# --- Telegram (facultatif) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Une seule instance doit faire le polling d'un même bot
TELEGRAM_POLLING_ENABLED=true
# Mode webhook (non utilisé par défaut) : route désactivée si vide
TELEGRAM_WEBHOOK_SECRET=
